# Inject secrets through your deployment environment. This optional local file
# never overrides existing process variables. Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only one host may ingest using a given provider account. Same-host workers
# elect one owner; other independent hosts must explicitly set this false.
ORBITWATCH_INGESTION_ENABLED=true
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=
# Shared same-host Live weather cache/budgets; no production database tables.
ORBITWATCH_WEATHER_PROVIDER_REQUESTS=true
# Optional absolute persistent local directory (default backend/.runtime/weather).
ORBITWATCH_WEATHER_CACHE_DIR=
