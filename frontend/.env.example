VITE_CESIUM_ION_TOKEN=your_cesium_ion_token
# Public HTTPS API URL in deployment; /api may instead be reverse-proxied on
# the frontend origin by explicitly setting this to an empty string.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional: enables the two CARTO cards in Map Settings
VITE_CARTO_API_KEY=your_carto_basemap_key
