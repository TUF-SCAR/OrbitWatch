# Inject secrets through your deployment environment. This optional local file
# never overrides existing process variables. Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only one host may ingest using a given provider account. Same-host workers
# elect one owner; other independent hosts must explicitly set this false.
ORBITWATCH_INGESTION_ENABLED=true
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=
# Shared same-host Live weather cache/budgets; no production database tables.
ORBITWATCH_WEATHER_PROVIDER_REQUESTS=true
# Optional absolute persistent local directory (default backend/.runtime/weather).
ORBITWATCH_WEATHER_CACHE_DIR=

# Future rendered infrared redistribution: BOTH flags must remain false until
# written permission covers mumi:worldcloudmap_ir108 retrieval, temporary disk
# caching AND public serving by OrbitWatch. Account access is not permission.
# Clarify retention/TTL, geographic/user limits, derivatives (alpha emphasis),
# attribution requirements and downstream EUMETSAT/NOAA/JMA third-party rights.
# Once approved: set BOTH true on ONE weather host with a persistent shared
# local directory; all API workers on that host must use the same directory.
# Frontend cutover is separate; existing browser WMS remains unchanged.
ORBITWATCH_INFRARED_ENABLED=false
ORBITWATCH_INFRARED_LICENSE_CONFIRMED=false
# Default backend/.runtime/infrared; 8 JPEGs <=8 MB each, widths 1024/2048.
# Shared layer quota 24/hour,160/day; >=60 seconds between ANY metadata/map
# requests (helpdesk guidance). Metadata reused >=15 min; no background poll.
ORBITWATCH_INFRARED_CACHE_DIR=

# Live small-body SBDB acquisition: one persistent PostgreSQL lease shared by
# ALL workers/hosts; daily checks, serial requests, <=24 requests/24 hours.
# Requires reviewed migration 007; startup never creates tables or migrates.
ORBITWATCH_SMALL_BODY_PROVIDER_REQUESTS=true
# Optional application/contact User-Agent override; default uses project issues URL.
ORBITWATCH_JPL_USER_AGENT=

# Read-only Live Earth report feeds: separate persistent caches/provider gates.
ORBITWATCH_EVENT_PROVIDER_REQUESTS=true
# Optional absolute directory (default backend/.runtime/events).
ORBITWATCH_EVENTS_CACHE_DIR=
# FIRMS hotspots are not enabled. A MAP_KEY alone does not activate an adapter;
# use EONET/GDACS fire reports until that optional integration is qualified.
